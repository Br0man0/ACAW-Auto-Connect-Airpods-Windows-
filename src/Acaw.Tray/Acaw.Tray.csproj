<Project Sdk="Microsoft.NET.Sdk">

  <!-- acaw-tray.exe : l'application résidente. WinExe = aucune fenêtre de console à l'ouverture. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>acaw-tray</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acaw.Windows\Acaw.Windows.csproj" />
  </ItemGroup>

</Project>
