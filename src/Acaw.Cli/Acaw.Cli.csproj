<Project Sdk="Microsoft.NET.Sdk">

  <!-- acaw.exe : la ligne de commande. Tout l'accès à Windows est dans Acaw.Windows. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>acaw</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acaw.Windows\Acaw.Windows.csproj" />
  </ItemGroup>

</Project>
